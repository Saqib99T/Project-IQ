[DATABASE]
db_host = localhost
db_port = 5432
db_name = Chatbot
db_user = postgres
# SECRET — supply at runtime via env var PIQ_DATABASE_DB_PASSWORD (see .env.example).
db_password =

[RASA]
rasa_api_url = http://localhost:5005

[WIDGET]
widget_title = IT Support
widget_subtitle = How can I help you today?

[KNOWLEDGE_BASE]
kb_enabled = true
; Service-account credentials for the KB bot (client_credentials grant) used by
; KBCacheManager's background refresh to call itsm-service. Leave blank to use
; the direct itsm-DB KB sync (common/kb_sync.py).
kb_bot_client_id =
kb_bot_client_secret =
kb_refresh_interval = 1800
kb_fallback_json = true
kb_semantic_enabled = true
kb_semantic_model = paraphrase-multilingual-MiniLM-L12-v2
kb_semantic_weight = 0.6
kb_keyword_weight = 0.4
kb_min_score = 0.3
kb_max_results = 3
kb_section_search_enabled = true
kb_section_min_words = 60
kb_section_max_words = 220
kb_section_max_results = 3
kb_section_clarify_min_score = 0.60
kb_section_clarify_max_score = 0.85
kb_qa_search_enabled = true
kb_qa_min_score = 0.85
kb_qa_max_results = 3

[FIRECRAWL]
firecrawl_api_key = fc-selfhosted
firecrawl_api_url = http://localhost:3002

[SESSION]
session_timeout_minutes = 30
# Minutes before the timeout to warn the user ("Still there?"). Must be < session_timeout_minutes.
session_warning_minutes = 10

[IAM]
keycloak_url           = https://id.dev.iam.99technologies.com
realm                  = 99-iam
client_id              = project-iq
api_url                = https://api.dev.iam.99technologies.com
backend_client_id      = project-iq-backend
# SECRET — supply at runtime via env var PIQ_IAM_BACKEND_CLIENT_SECRET (see .env.example).
# Never commit a real value here.
backend_client_secret  =

[PLATFORM]
; 99Tech Dev org_id in IAM — users in this org are platform-tier in itsm-service
org_id         = 7d35c7c9-dbd6-4f6b-8d0c-07178923d859

[SLA]
critical_hours = 2
high_hours     = 4
medium_hours   = 8
low_hours      = 24

[ITSM]
itsm_service_url = http://127.0.0.1:8000

[SHOPIFY]
; Global app-level credentials for Project IQ's Shopify Partner app (one per
; deployment). Per-tenant shop connections (shop_domain + access_token) live
; in the shopify_connections DB table, NOT here — see common/db/_connection.py.
shopify_enabled     = false
api_version         = 2026-01
client_id           =
; SECRET — supply at runtime via env var PIQ_SHOPIFY_CLIENT_SECRET (see .env.example).
; Never commit a real value here.
client_secret       =
redirect_uri        = http://localhost:8181/admin/shopify/callback
scopes              = read_orders,read_customers,write_orders
; Per-tenant cap on refund/cancel/shipping-address-update write actions.
write_rate_limit    = 10 per hour

[AMAZON]
; Global app-level credentials for Project IQ's Amazon SP-API app (one per
; deployment), registered via the Solution Provider Portal. Per-tenant seller
; connections (marketplace_id + OAuth tokens) live in the amazon_connections
; DB table, NOT here — see docs/AMAZON_INTEGRATION_PLAN.md.
amazon_enabled      = false
environment         = sandbox
; app_id (amzn1.sp.solution.xxx) builds the seller-consent authorize URL —
; different from client_id (amzn1.application-oa2-client.xxx), used for the
; LWA token exchange. Both come from the same Solution Provider Portal app.
app_id              =
client_id           =
; SECRET — supply at runtime via env var PIQ_AMAZON_CLIENT_SECRET (see .env.example).
; Never commit a real value here.
client_secret       =
redirect_uri        = http://localhost:8181/admin/amazon/callback
marketplace_ids     = ATVPDKIKX0DER
; Per-tenant cap on write actions once Phase 5 (refund/cancel) is built.
write_rate_limit    = 10 per hour

[AMAZON_NOTIFICATIONS]
; SQS Notifications API consumer (docs/AMAZON_INTEGRATION_PLAN.md Phase 4).
; UNVALIDATED against live SP-API as of this build (client_id above is also
; unset) — do not set notifications_enabled=true without first confirming
; register_destination()/subscribe() work in the SP-API sandbox
; (extensions/amazon/notifications.py) and this queue ARN is real.
notifications_enabled  = false
aws_region             =
sqs_queue_arn          =
; SECRETS — supply at runtime via PIQ_AMAZON_NOTIFICATIONS_AWS_ACCESS_KEY_ID /
; PIQ_AMAZON_NOTIFICATIONS_AWS_SECRET_ACCESS_KEY (see .env.example). Never
; commit real values here.
aws_access_key_id      =
aws_secret_access_key  =
poll_interval_seconds  = 20

[WHATSAPP]
; Global WhatsApp Cloud API credentials (one business number per deployment) —
; docs/plans/WHATSAPP_INTEGRATION_PLAN.md (1:1 support) and
; docs/plans/WHATSAPP_GROUP_ASSISTANT_PLAN.md (group assistant).
; *** Level B testing (Meta's free test WABA — see plan doc §8 Phase 0a/0b):
; phone_number_id/waba_id below are the test app's real identifiers, NOT
; secrets. access_token/app_secret/verify_token are still blank here on
; purpose — set those in your LOCAL .env only, never in this file. ***
whatsapp_enabled        = true
; Groups API needs an Official Business Account, a materially higher bar than
; the base WABA (group plan §1.1) — kept separate so 1:1 support can go live
; without group support being ready, and vice versa.
groups_enabled          = false
graph_api_version       = v23.0
phone_number_id         = 1314538265077787
waba_id                 = 2108520466418577
; SECRETS — supply at runtime via PIQ_WHATSAPP_ACCESS_TOKEN /
; PIQ_WHATSAPP_APP_SECRET / PIQ_WHATSAPP_VERIFY_TOKEN /
; PIQ_WHATSAPP_INTERNAL_ASSERTION_SECRET (see .env.example).
; Never commit real values here.
access_token            =
app_secret              =
verify_token            =
; Shared with itsm-service — Keycloak-independent fallback for account-
; scoped WhatsApp actions when Keycloak token-exchange access isn't
; available (docs/plans/WHATSAPP_INTEGRATION_PLAN.md 2026-08-27 note).
; Blank = disabled, degrades to "sign in required" as before this existed.
internal_assertion_secret =
; Default proactivity dial for a group that hasn't set its own (see
; extensions/whatsapp/decision.py) — starts at the most conservative setting
; per the group plan's §9 decision #2 recommendation.
default_proactivity_level  = mention_only
proactive_cooldown_seconds = 600
; Every send is billed per-message (group plan §4) — this caps runaway
; proactive/retry loops from becoming a cost incident, not just a UX one.
send_rate_limit         = 60 per hour

[SENTRY]
; Self-hosted Sentry (sentry.99technologies.com). Shared by web/api and
; action_server — blank disables the SDK entirely (no code change needed to
; turn it on later, just set this). Not a secret — a DSN is meant to be
; embedded in client code, it's a routing address, not a credential.
dsn                 =

