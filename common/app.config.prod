[PROFILE]
profile = prod
debug = false

[DATABASE]
db_host = localhost
db_port = 5432
db_name = Chatbot
db_user = postgres
# SECRET — supply at runtime via env var PIQ_DATABASE_DB_PASSWORD (see .env.example).
db_password =

[RASA]
# Points to the internal Nginx Rasa load balancer (port 5000).
# Nginx distributes calls to all running rasa-core@XXXX instances.
# To revert to a single instance: change back to http://localhost:5005
rasa_api_url = http://127.0.0.1:5000
rasa_action_url = http://127.0.0.1:5055/webhook

[SERVER]
admin_port = 8181
cors_origins = *

[SESSION]
session_timeout_minutes = 30
# Minutes before the timeout to warn the user ("Still there?"). Must be < session_timeout_minutes.
session_warning_minutes = 10

[WIDGET]
widget_title = IT Support
widget_subtitle = How can I help you today?

[KNOWLEDGE_BASE]
kb_enabled = true
kb_refresh_interval = 3600
kb_fallback_json = true
kb_semantic_enabled = true
kb_semantic_model = paraphrase-multilingual-MiniLM-L12-v2
kb_semantic_weight = 0.6
kb_keyword_weight = 0.4
kb_min_score = 0.3
kb_max_results = 3
kb_section_search_enabled = true
kb_section_min_words = 60
kb_section_max_words = 220
kb_section_max_results = 3
kb_section_clarify_min_score = 0.60
kb_section_clarify_max_score = 0.85
kb_qa_search_enabled = true
kb_qa_min_score = 0.85
kb_qa_max_results = 3

[FIRECRAWL]
firecrawl_api_key = fc-selfhosted
firecrawl_api_url = http://localhost:3002

[HANDOFF]
# SECRET — JWT secret for operator dashboard auth. Supply at runtime via env var
# PIQ_HANDOFF_OPERATOR_JWT_SECRET (see .env.example). Never commit a real value.
operator_jwt_secret =

operator_jwt_expiry_hours = 24

# Socket.IO transport settings
socketio_async_mode = eventlet
socketio_ping_timeout = 60
socketio_ping_interval = 25
socketio_cors_allowed_origins = *

# Operator session — seconds before a missed-heartbeat operator goes offline
operator_heartbeat_timeout_secs = 90

# SMTP for transcript emails
smtp_host = YOUR_SMTP_HOST
smtp_port = 587
smtp_user = YOUR_SMTP_USER
smtp_password = YOUR_SMTP_PASSWORD
smtp_from = support@yourcompany.com
smtp_use_tls = true

# LLM-based AI summary (disabled by default — rule-based summary used instead)
llm_summary_enabled = false
llm_summary_model = claude-haiku-4-5-20251001
llm_api_key = YOUR_LLM_API_KEY_IF_ENABLED

[REDIS]
# Enable Redis for caching + Socket.IO message bus across Gunicorn workers.
# Required when GUNICORN_WORKERS > 1.
redis_enabled = true
redis_host    = localhost
redis_port    = 6379
redis_db      = 0
redis_password =

[DATABASE_REPLICA]
# Read replica for PostgreSQL — routes read-only queries to replica, writes to primary.
# Leave db_replica_host blank to disable (all queries go to primary).
db_replica_host     =
db_replica_port     = 5432
db_replica_name     = Chatbot
db_replica_user     = postgres
# SECRET — supply at runtime via env var PIQ_DATABASE_REPLICA_DB_REPLICA_PASSWORD (replica disabled by default).
db_replica_password =

