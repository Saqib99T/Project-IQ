[PROFILE]
profile = prod
debug = false

[GLPI]
glpi_api_url = http://YOUR_PROD_SERVER/apirest.php
glpi_app_token = YOUR_PROD_APP_TOKEN
glpi_user_token = YOUR_PROD_USER_TOKEN

[DATABASE]
db_host = YOUR_PROD_DB_HOST
db_port = 5432
db_name = Chatbot
db_user = postgres
db_password = YOUR_PROD_DB_PASSWORD

[RASA]
rasa_api_url = http://localhost:5005
rasa_action_url = http://127.0.0.1:5055/webhook

[SERVER]
admin_port = 8181
cors_origins = https://YOUR_PROD_DOMAIN

[WIDGET]
widget_title = IT Support
widget_subtitle = How can I help you today?

[KNOWLEDGE_BASE]
kb_glpi_enabled = true
kb_refresh_interval = 3600
kb_fallback_json = true
kb_semantic_enabled = true
kb_semantic_model = all-MiniLM-L6-v2
kb_semantic_weight = 0.6
kb_keyword_weight = 0.4
kb_min_score = 0.3
kb_max_results = 3
kb_section_search_enabled = true
kb_section_min_words = 60
kb_section_max_words = 220
kb_section_max_results = 3
kb_section_clarify_min_score = 0.60
kb_section_clarify_max_score = 0.85
kb_qa_search_enabled = true
kb_qa_min_score = 0.85
kb_qa_max_results = 3

[FIRECRAWL]
firecrawl_api_key = YOUR_FIRECRAWL_API_KEY
firecrawl_api_url = http://localhost:3002

[HANDOFF]
# JWT secret for operator dashboard authentication — MUST be changed before go-live
operator_jwt_secret = YOUR_STRONG_PROD_JWT_SECRET_HERE

# GLPI group enforcement for operator login
# Requires operators to be members of the named GLPI group before they can log in
glpi_group_enforcement = true
glpi_support_group_name = Support
operator_jwt_expiry_hours = 24

# Socket.IO transport settings
socketio_async_mode = eventlet
socketio_ping_timeout = 60
socketio_ping_interval = 25
socketio_cors_allowed_origins = https://YOUR_PROD_DOMAIN

# Operator session — seconds before a missed-heartbeat operator goes offline
operator_heartbeat_timeout_secs = 90

# SMTP for transcript emails
smtp_host = YOUR_SMTP_HOST
smtp_port = 587
smtp_user = YOUR_SMTP_USER
smtp_password = YOUR_SMTP_PASSWORD
smtp_from = support@yourcompany.com
smtp_use_tls = true

# LLM-based AI summary (disabled by default — rule-based summary used instead)
llm_summary_enabled = false
llm_summary_model = claude-haiku-4-5-20251001
llm_api_key = YOUR_LLM_API_KEY_IF_ENABLED

