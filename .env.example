# Project IQ — runtime secrets template.
#
# Copy to `.env` (git-ignored) for local dev, or set these as real environment
# variables on the server (systemd `Environment=` / container env / deploy secret).
# common/config_manager.py reads PIQ_<SECTION>_<OPTION> and prefers it over the
# value in app.config*; when unset, the (now blank) file value is used.
#
# Naming: PIQ_<SECTION>_<OPTION>, both uppercased, matching app.config sections.
# Never commit a filled-in copy.

# --- IAM / Keycloak ---------------------------------------------------------
# [IAM] backend_client_secret — confidential-client secret the backend uses to
# authenticate to Keycloak (token exchange, service accounts).
PIQ_IAM_BACKEND_CLIENT_SECRET=

# --- Database ---------------------------------------------------------------
# [DATABASE] db_password — primary Postgres password.
# No local Postgres yet? `docker compose -f docker-compose.dev.yml up -d`
# stands up Postgres (+ pgvector) and Redis for local dev — set this to
# `dev_password` to match it (see docker-compose.dev.yml).
PIQ_DATABASE_DB_PASSWORD=
# [DATABASE_REPLICA] db_replica_password — only if a read replica is enabled.
PIQ_DATABASE_REPLICA_DB_REPLICA_PASSWORD=

# --- Operator handoff / dashboard ------------------------------------------
# [HANDOFF] operator_jwt_secret — signs operator-dashboard JWTs. Rotating it
# invalidates all existing operator sessions (operators must re-login).
PIQ_HANDOFF_OPERATOR_JWT_SECRET=
# [HANDOFF] smtp_password — transcript-email SMTP password (if SMTP enabled).
PIQ_HANDOFF_SMTP_PASSWORD=
# [HANDOFF] llm_api_key — Anthropic key, only if llm_summary_enabled = true.
PIQ_HANDOFF_LLM_API_KEY=

# --- Knowledge base bot service account ------------------------------------
# [KNOWLEDGE_BASE] kb_bot_client_secret — client_credentials secret the KB
# refresh thread uses to call itsm-service (leave blank to use direct DB sync).
PIQ_KNOWLEDGE_BASE_KB_BOT_CLIENT_SECRET=

# --- Shopify integration -----------------------------------------------------
# [SHOPIFY] client_secret — the Partner app's OAuth client secret (one per
# deployment; a tenant's own shop connection/access token is stored in the
# shopify_connections DB table, not here). Leave blank until the Shopify
# Partner app is registered (see docs/SHOPIFY_INTEGRATION_PLAN.md Phase 0).
PIQ_SHOPIFY_CLIENT_SECRET=
# [AMAZON] client_secret — the SP-API app's LWA client secret (one per
# deployment; a tenant's own seller connection/access token is stored in the
# commerce_connections DB table, not here). Leave blank until the Amazon app
# is registered via the Solution Provider Portal (see docs/AMAZON_INTEGRATION_PLAN.md Phase 0).
PIQ_AMAZON_CLIENT_SECRET=
# [AMAZON_NOTIFICATIONS] SQS consumer AWS credentials (docs/AMAZON_INTEGRATION_PLAN.md
# Phase 4) — UNVALIDATED against live SP-API as of this build. Leave blank
# (notifications_enabled stays false) until register_destination()/subscribe()
# in extensions/amazon/notifications.py have been confirmed against the SP-API
# sandbox with full credentials (client_id included).
PIQ_AMAZON_NOTIFICATIONS_AWS_ACCESS_KEY_ID=
PIQ_AMAZON_NOTIFICATIONS_AWS_SECRET_ACCESS_KEY=
# --- WhatsApp integration ----------------------------------------------------
# [WHATSAPP] Cloud API credentials (docs/plans/WHATSAPP_INTEGRATION_PLAN.md,
# docs/plans/WHATSAPP_GROUP_ASSISTANT_PLAN.md) — UNVALIDATED as of this build,
# no live Meta Business/WABA account exists yet. Leave all three blank
# (whatsapp_enabled stays false) until a real System User access token, app
# secret, and a webhook verify token you've chosen yourself are in hand.
PIQ_WHATSAPP_ACCESS_TOKEN=
PIQ_WHATSAPP_APP_SECRET=
PIQ_WHATSAPP_VERIFY_TOKEN=
# Shared with itsm-service (same value in BOTH repos' env) — Keycloak-
# independent fallback for account-scoped WhatsApp actions when Keycloak
# token-exchange access isn't available (docs/plans/WHATSAPP_INTEGRATION_PLAN.md
# 2026-08-27 note). Generate with `openssl rand -hex 32`. Leave blank to
# disable (degrades to "sign in required", same as before this existed).
PIQ_WHATSAPP_INTERNAL_ASSERTION_SECRET=
# common/crypto.py — encrypts shopify_connections.access_token (and any future
# per-tenant DB-stored secret) at rest. NOT a PIQ_<SECTION>_<OPTION> override —
# read directly by common/crypto.py, required in every environment that touches
# shopify_connections. Rotating this breaks decryption of existing rows.
PIQ_SECRET_ENCRYPTION_KEY=
