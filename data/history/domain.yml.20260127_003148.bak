version: "3.1"

intents:
  - greet
  - goodbye
  - login
  - create_ticket
  - update_ticket
  - verify_resolution
  - submit_ticket_form
  - check_status
  - inform
  - inform_update
  - deny
  - affirm
  - stop
  - out_of_scope
  - list_tickets
  - view_comments
  - help
  - upload_file 
  - list_attachments
  - clear
  - show_chart
  - ask_knowledge
  - feedback_positive
  - feedback_negative
  - multi_action
  - kb_not_helpful
  - rating_1
  - rating_2
  - rating_3
  - rating_4
  - rating_5
  - show_ticket_graph

entities:
  - ticket_id
  - app_id
  - description
  - issue_type
  - urgency
  - update_content
  - target_status
  - file_name
  - file_data
  - chart_type
  - glpi_username
  - glpi_password

slots:
  ticket_id:
    type: text
    influence_conversation: true
    mappings:
      - type: from_entity
        entity: ticket_id
      - type: from_entity
        entity: ticket_id
  
  app_id:
    type: text
    influence_conversation: true
    mappings: # Can be set by custom actions or metadata
      - type: from_entity
        entity: app_id
        
  ticket_title: 
    type: text
    influence_conversation: false
    mappings:
      - type: from_entity
        entity: description 
      - type: from_text
        conditions:
         - active_loop: ticket_form
           requested_slot: ticket_title 
        
  ticket_content:
    type: text
    influence_conversation: false
    mappings:
      - type: custom
  ticket_detail:
    type: text
    influence_conversation: false
    mappings:
      - type: custom
  priority:
    type: text
    influence_conversation: false
    mappings:
      - type: custom
  category:
    type: text
    influence_conversation: false
    mappings:
      - type: custom 
           
  update_content:
    type: text
    influence_conversation: false
    mappings:
      - type: from_entity
        entity: update_content
      - type: from_text
        intent: inform_update

  file_name:
    type: text
    influence_conversation: false
    mappings: 
      - type: from_entity
        entity: file_name

  file_data:
    type: text
    influence_conversation: false
    mappings: 
      - type: from_entity
        entity: file_data

  target_status:
    type: text
    influence_conversation: false
    mappings:
      - type: from_entity
        entity: target_status
  
  issue_type:
    type: categorical
    values:
      - Hardware
      - Software
      - Network
      - Other
    influence_conversation: false
    mappings:
      - type: from_entity
        entity: issue_type
        intent: create_ticket
      - type: from_entity
        entity: issue_type
        
  urgency:
    type: categorical
    values:
      - Low
      - Medium
      - High
    influence_conversation: false
    mappings:
      - type: from_entity
        entity: urgency
        intent: create_ticket
      - type: from_entity
        entity: urgency
        
  ticket_status:
    type: text
    influence_conversation: false
    mappings: []
    
  session_token:
    type: text
    influence_conversation: false
    mappings: []

  glpi_username:
    type: text
    influence_conversation: false
    mappings:
      - type: from_entity
        entity: glpi_username

  glpi_password:
    type: text
    influence_conversation: false
    mappings:
      - type: from_entity
        entity: glpi_password

  is_authenticated:
    type: bool
    influence_conversation: false
    mappings: []

  glpi_user_id:
    type: text
    influence_conversation: false
    mappings: []

  glpi_user_name:
    type: text
    influence_conversation: false
    mappings: []

  chart_type:
    type: text
    influence_conversation: false
    mappings:
      - type: from_entity
        entity: chart_type

  requested_slot:
    type: text
    influence_conversation: false
    mappings: []

  kb_articles_shown:
    type: bool
    influence_conversation: false
    mappings: []

responses:
  utter_greet:
    - text: "👋 **Hello! Welcome to IT Support Bot!**

I'm here to help you with your IT needs. Here's what I can do for you:

🎫 **Create a Ticket** - Report issues or request assistance
📋 **View My Tickets** - See all your open and closed tickets
🔍 **Check Ticket Status** - Get updates on a specific ticket
📚 **Search Knowledge Base** - Find solutions before creating a ticket
💬 **Add Comments** - Update your tickets with new information

How can I assist you today?"
      buttons:
        - title: "🎫 Create Ticket"
          payload: "/create_ticket"
        - title: "📋 View My Tickets"
          payload: "/list_tickets"
        - title: "🔍 Check Status"
          payload: "/check_status"
        - title: "❓ Help"
          payload: "/help"
  utter_goodbye:
    - text: "Goodbye! Let me know if you need anything else."
  utter_ask_ticket_id:
    - text: "Please provide the **ID of the ticket** you want to check (e.g., GLPI-1234 or just 1234)."
  utter_ticket_status_info:
    - text: "The status for ticket **{ticket_id}** is **{ticket_status}**."
  utter_ticket_id_not_found:
    - text: "I couldn't find a ticket with the ID **{ticket_id}**. Please double-check the number."
  utter_stop_form:
    - text: "Okay, I've stopped the ticket creation process. What would you like to do instead?"
  utter_ask_anything_else:
    - text: "Is there anything else I can help you with?"
  
  utter_ask_update_content:
    - text: "What additional information would you like to add to the ticket?"
    
  utter_ticket_updated:
    - text: "I've added that information to your ticket."

  utter_ticket_closed:
    - text: "Great! I've marked the ticket as closed."
  
  utter_ask_target_status:
    - text: "The ticket is currently **{ticket_status}**. What should the new status be? (e.g. Processing, Solved, Pending)"
      buttons:
        - title: "Processing (Planned)"
          payload: '/inform_update{{"target_status":"Processing (Planned)"}}'
        - title: "Pending"
          payload: '/inform_update{{"target_status":"Pending"}}'
        - title: "Solved"
          payload: '/inform_update{{"target_status":"Solved"}}'

  # Form prompts
  utter_ask_confirm_ticket:
    - text: "I have gathered the following details:\n\n**Title:** {ticket_title}\n**Content:** {ticket_content}\n**Issue Type:** {issue_type}\n**Urgency:** {urgency}\n\nDo you want to create this ticket?"
      buttons:
        - title: "Yes, create it"
          payload: "/affirm"
        - title: "No, cancel"
          payload: "/deny"
  utter_ask_ticket_title: 
    - text: "Please provide a **short summary/title** for the problem."
      buttons:
        - title: "Cancel"
          payload: "/stop"
  utter_ask_ticket_content: 
    - text: "Now, please describe the problem **in detail** (the content for the ticket)."
      buttons:
        - title: "Cancel"
          payload: "/stop"
  utter_ask_issue_type:
    - text: "What type of issue is this? (Hardware, Software, Network, or Other)"
      buttons:
        - title: "Hardware"
          payload: '/inform{{"issue_type":"Hardware"}}'
        - title: "Software"
          payload: '/inform{{"issue_type":"Software"}}'
        - title: "Network"
          payload: '/inform{{"issue_type":"Network"}}'
        - title: "Other"
          payload: '/inform{{"issue_type":"Other"}}'
        - title: "Cancel"
          payload: "/stop"
  utter_ask_urgency:
    - text: "What is the urgency level? (Low, Medium, or High)"
      buttons:
        - title: "Low"
          payload: '/inform{{"urgency":"Low"}}'
        - title: "Medium"
          payload: '/inform{{"urgency":"Medium"}}'
        - title: "High"
          payload: '/inform{{"urgency":"High"}}'
        - title: "Cancel"
          payload: "/stop"
    
  utter_ticket_creation_failed:
    - text: "Sorry, I ran into an error and could not create your ticket in GLPI."
  utter_ask_retry:
    - text: "Would you like to try again?"
  utter_error_occurred:
    - text: "An error occurred while processing your request."
  utter_ask_how_can_help:
    - text: "How can I help you today?"
  utter_help:
    - text: "I can help you create tickets, check status, or update existing tickets.\n\nTo **attach a file**, simply click the 📎 **Paperclip icon** in the chat bar (make sure you have selected a ticket first by creating one or checking its status)."
  utter_ask_continue:
    - text: "Do you want to continue?"
  utter_ask_ticket_id_again:
    - text: "Please provide the ticket ID again."
  utter_ticket_not_found:
    - text: "Ticket not found."
  utter_operation_cancelled:
    - text: "Operation cancelled."
  utter_please_rephrase:
    - text: "I'm sorry, I didn't verify that. Could you rephrase?"
  utter_default:
    - text: "I'm not sure I understand. Here's what I can help you with:"
      buttons:
        - title: "📋 List my tickets"
          payload: '/list_tickets'
        - title: "🎫 Create a ticket"
          payload: '/create_ticket'
        - title: "🔍 Check ticket status"
          payload: '/check_status'
        - title: "❓ Help"
          payload: '/help'
    
  utter_out_of_scope:
    - text: "I'm a GLPI support bot and can help you with tickets. I can't help with that request."
    - text: "I'm here to help with GLPI tickets only. Try asking about creating or viewing tickets!"
    
  utter_cleared:
    - text: "Session cleared. I've forgotten everything by resetting slots. How can I help you now?"

  utter_ask_satisfaction:
    - text: "How satisfied are you with our service?"
      buttons:
        - title: "⭐ Great"
          payload: '/feedback_positive'
        - title: "😞 Not good"
          payload: '/feedback_negative'

  utter_ticket_form:
    - custom:
        ticket_form: true
        text: "Please fill out the ticket details below:"

  utter_thanks_positive_rating:
    - text: "Thank you for the great feedback! 🎉 Is there anything else I can help you with?"

  utter_ask_improvement:
    - text: "I'm sorry to hear that. What could we do better? Your feedback helps us improve."


actions:
  - action_glpi_login
  - action_init_glpi_session
  - action_create_glpi_ticket
  - action_check_glpi_status
  - action_update_glpi_ticket
  - action_verify_glpi_resolution
  - action_deactivate_form
  - action_view_ticket_comments
  - action_list_open_tickets
  - action_upload_file
  - action_list_attachments
  - action_clear_session
  - action_extract_context
  - action_greet
  - action_show_chart
  - action_search_knowledge_base
  - action_save_feedback
  - action_handle_multi_intent
  - action_search_kb_before_ticket
  - action_create_ticket_from_form
  - action_save_satisfaction_rating
  - action_show_ticket_graph

forms:
  ticket_form:
    required_slots:
      - ticket_title
      - ticket_content
      - issue_type
      - urgency

session_config:
  session_expiration_time: 60
  carry_over_slots_to_new_session: true