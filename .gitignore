# Ignore environment files with secrets
.env
.env.*
!.env.infisical.template
!.env.example
core/.rasa
.rasa/
.agent
.claude

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/

# IDE
.vscode/
.idea/

# Logs
*.log
Log/

# Models (large files) — regenerable Rasa training artifacts, kept out of git
models/*.tar.gz
core/models/*.tar.gz
core/models/*.zip

# OS
.DS_Store
Thumbs.db
nul
_nul

# Database backups (large binary files)
backups/*.backup

# Rasa
core/models/*.tar.gz
data/history/

# Firecrawl self-host (node_modules, build output, generated files)
firecrawl-selfhost/
firecrawl-selfhost/**/node_modules/
firecrawl-selfhost/**/.next/
firecrawl-selfhost/**/dist/
firecrawl-selfhost/**/.turbo/
firecrawl-selfhost/apps/go-sdk/firecrawl-go/
firecrawl-selfhost/apps/go-sdk/firecrawl-go-examples/

# Build / dist
web/ui/dist/
web/ui/dist-widget/glpi-chat-widget.js
web/ui/dist-widget/modern-web-interface.css

# Credentials (belt-and-suspenders)
.env.bak
*.bak
# Signing keystores + their secret notes — never track
expo-app/credentials/
*.jks
*.keystore

# Build artifacts — regenerable, kept out of git (APK via EAS/Releases, KB cache regenerated at runtime)
expo-app/*.apk
expo-app/*.aab
web/data/cache/
common/kb_embeddings_cache.json
common/intent_index_cache.npz
