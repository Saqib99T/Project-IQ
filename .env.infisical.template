# Infisical Environment Variables
# For Infisical Cloud (recommended - no setup required)

# Get these from https://app.infisical.com
# Project Settings > Machine Identities > Create Machine Identity
INFISICAL_CLIENT_ID=your-client-id
INFISICAL_CLIENT_SECRET=your-client-secret
INFISICAL_PROJECT_ID=your-project-id
INFISICAL_ENVIRONMENT=prod

# For Infisical Cloud, leave this as default (or don't set it)
# INFISICAL_SITE_URL=https://app.infisical.com

# For self-hosted Infisical, uncomment and set your URL:
# INFISICAL_SITE_URL=http://your-server:8089
