            "distribution": "internal"
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "simulator": false
            },
            "env": {
                "EAS_NO_VCS": "1"
            }
        },
        "preview-ios": {
            "distribution": "internal",
            "ios": {
                "simulator": false
            },
            "env": {
                "EAS_NO_VCS": "1"
            }
        },
        "production": {
            "distribution": "store",
            "ios": {
                "simulator": false
            },
            "env": {
                "EAS_NO_VCS": "1"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "appleId": "saqib.idrees@99technologies.com",
                "ascAppId": "6761477401",
                "appleTeamId": "XJGZ2FPYC8"
