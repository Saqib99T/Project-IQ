{
    "cli": {
        "version": ">= 3.8.1"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal"
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "simulator": false
            },
            "env": {
                "EAS_NO_VCS": "1"
            }
        },
        "preview-ios": {
            "distribution": "internal",
            "ios": {
                "simulator": false
            },
            "env": {
                "EAS_NO_VCS": "1"
            }
        },
        "production": {
            "distribution": "store",
            "ios": {
                "simulator": false
            },
            "env": {
                "EAS_NO_VCS": "1"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "appleId": "YOUR_APPLE_ID@example.com",
                "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
                "appleTeamId": "YOUR_APPLE_TEAM_ID"
            }
        }
    }
}